// vim: set ft=dts:

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// define layers
// SYM=1 and NUM=2 intentionally match the toucan shield's hardcoded
// glidepoint_listener scroller `layers = <1 2>`, so holding either
// thumb layer converts trackpad movement to scroll — no overlay needed.
#define COLEMAK   0
#define SYM       1
#define NUM       2
#define SYS       3
#define NAV       4
#define SYS_ADMIN 5
// GAME=6 and GAME_EXT=7 are mirrored as literals in the toucan shield's
// `gaming_mute` input-listener override (`layers = <6 7>`), which silences the
// trackpad while gaming — keep the two in sync.
#define GAME      6
#define GAME_EXT  7

// Configure the layer tap — quick-tap-ms lets tap-then-hold repeat (e.g. backspace).
&lt {
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // Holding both thumb layer keys on the left hand activates SYS_ADMIN.
        sys_admin_left {
            if-layers = <SYM SYS>;
            then-layer = <SYS_ADMIN>;
        };

        // Holding both thumb layer keys on the right hand also activates SYS_ADMIN.
        sys_admin_right {
            if-layers = <NAV NUM>;
            then-layer = <SYS_ADMIN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─── Toucan 36 physical layout note ────────────────────────────────────
        // The shield matrix has 6 columns per half (42 binding slots total), but
        // the Toucan 36 (Cantor layout) only populates the inner 5 columns per
        // half.  Outer column positions RC(r,0) and RC(r,11) have no physical key
        // and are bound to &none throughout.
        //
        // All six thumb keys DO exist — three per half, 18 keys per half, 36 in
        // total.  The outer thumbs (leftmost on the left half, rightmost on the
        // right) are simply unused on the typing layers and left &none there.
        // gaming_layer below binds the left outer thumb as its sub-layer hold.
        // ────────────────────────────────────────────────────────────────────────

        colemak_layer {
            display-name = "COLEMAK";
            bindings = <
        //╭────────┬──────────┬────────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬────────────┬──────────┬────────╮
        //│ (none) │  Q       │  W/CTRL    │  F/ALT   │  P/CMD   │  G       │   │  J       │  L/CMD   │  U/ALT   │  Y/CTRL    │  ;       │ (none) │
            &none    &kp Q    &ht LCTRL W  &ht LALT F  &ht LCMD P  &kp G          &kp J   &ht RCMD L  &ht RALT U  &ht RCTRL Y  &kp SEMI   &none
        //├────────┼──────────┼────────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼────────────┼──────────┼────────┤
        //│ (none) │  A       │  R         │  S       │  T       │  D       │   │  H       │  N       │  E       │  I         │  O       │ (none) │
            &none    &kp A      &kp R        &kp S      &kp T      &kp D          &kp H    &kp N       &kp E       &kp I        &kp O      &none
        //├────────┼──────────┼────────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼────────────┼──────────┼────────┤
        //│ (none) │  Z/SHIFT │  X         │  C       │  V       │  B       │   │  K       │  M       │  ,       │  .         │  //SHIFT │ (none) │
            &none  &ht LSHFT Z  &kp X        &kp C      &kp V      &kp B          &kp K    &kp M    &kp COMMA    &kp DOT   &ht RSHFT FSLH  &none
        //╰────────┴──────────┴────────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼────────────┴──────────┴────────╯
        //                                 │  (none)  │ SYM/BSPC │ SYS/SPC  │   │ NAV/RET  │  NUM     │  (none)  │
                                           &none   &lt SYM BSPC &lt SYS SPACE   &lt NAV RET  &mo NUM   &none
        //                                 ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
            >;
        };

        symbols_layer {
            display-name = "SYM";
            bindings = <
        //╭────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬────────╮
        //│        │  !       │  @       │  #       │  $       │  %       │   │  ^       │  &       │  *       │  _       │  +       │        │
            &trans   &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT      &kp CARET  &kp AMPS   &kp STAR   &kp UNDER  &kp PLUS   &trans
        //├────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│        │  '       │  [       │  {       │  (       │  `       │   │  ~       │  )       │  }       │  ]       │  "       │        │
            &trans   &kp APOS   &kp LBKT   &kp LBRC   &kp LPAR   &kp GRAVE      &kp TILDE  &kp RPAR   &kp RBRC   &kp RBKT   &kp DQT    &trans
        //├────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│        │          │          │          │          │          │   │          │  -       │  =       │  \       │  |       │        │
            &trans   &trans     &trans     &trans     &trans     &trans         &trans     &kp MINUS  &kp EQUAL  &kp BSLH   &kp PIPE   &trans
        //╰────────┴──────────┴──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┴──────────┴────────╯
                                           &none      &trans     &trans         &trans     &trans     &none
        //                               ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
            >;
        };

        numbers_layer {
            display-name = "NUM";
            bindings = <
        //╭────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬────────╮
        //│        │  F1      │  F2      │  F3      │  F4      │  F5      │   │  F6      │  F7      │  F8      │  F9      │  F10     │        │
            &trans   &kp F1     &kp F2     &kp F3     &kp F4     &kp F5         &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &trans
        //├────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│        │  1       │  2       │  3       │  4       │  5       │   │  6       │  7       │  8       │  9       │  0       │        │
            &trans   &kp N1     &kp N2     &kp N3     &kp N4     &kp N5         &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &trans
        //├────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│        │  F11     │  F12     │  F13     │  F14     │  F15     │   │  F16     │  F17     │  F18     │  F19     │  F20     │        │
            &trans   &kp F11    &kp F12    &kp F13    &kp F14    &kp F15        &kp F16    &kp F17    &kp F18    &kp F19    &kp F20    &trans
        //╰────────┴──────────┴──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┴──────────┴────────╯
                                           &none      &trans     &trans         &trans     &trans     &none
        //                               ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
            >;
        };

        system_layer {
            display-name = "SYS";
            bindings = <
        //╭────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬────────╮
        //│        │          │          │          │          │ GAME on  │   │          │          │          │          │          │        │
            &trans   &trans     &trans     &trans     &trans     &tog GAME      &trans     &trans     &trans     &trans     &trans     &trans
        //├────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│        │ BT 1     │ BT 2     │ BT 3     │ BT 4     │          │   │          │          │          │          │ OUT TOG  │        │
            &trans  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &trans  &trans  &trans     &trans     &trans   &out OUT_TOG  &trans
        //├────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│        │          │          │          │          │          │   │          │          │          │          │          │        │
            &trans   &trans     &trans     &trans     &trans     &trans         &trans     &trans     &trans     &trans     &trans     &trans
        //╰────────┴──────────┴──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┴──────────┴────────╯
                                           &none      &trans     &trans         &trans     &trans     &none
        //                               ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
            >;
        };

        navigation_layer {
            display-name = "NAV";
            bindings = <
        //╭────────┬──────────┬──────────────┬──────────────┬───────────────┬───────────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬────────╮
        //│        │  ESC     │  scroll →    │  mouse ↑     │  scroll ←     │  scroll ↓     │   │          │  HOME    │  PG DN   │  PG UP   │  END     │        │
            &trans   &kp ESC  &msc MOVE_RIGHT &mmv MOVE_UP  &msc MOVE_LEFT  &msc MOVE_DOWN        &trans   &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &trans
        //├────────┼──────────┼──────────────┼──────────────┼───────────────┼───────────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│        │  TAB     │  mouse ←     │  mouse ↓     │  mouse →      │  scroll ↑     │   │          │  ←       │  ↓       │  ↑       │  →       │        │
            &trans   &kp TAB  &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc MOVE_UP          &trans   &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &trans
        //├────────┼──────────┼──────────────┼──────────────┼───────────────┼───────────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│        │  CAPS WD │  prev track  │  play/pause  │  next track   │               │   │          │  vol dn  │  vol up  │  mute    │          │        │
            &trans  &caps_word  &kp C_PREV     &kp C_PP       &kp C_NEXT     &trans                &trans  &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &trans   &trans
        //╰────────┴──────────┴──────────────┼──────────────┼───────────────┼───────────────┤   ├──────────┼──────────┼──────────┼──────────┴──────────┴────────╯
        //                                   │  click 1     │  click 2      │               │   │          │          │          │
                                               &none          &mkp MB1        &mkp MB2              &trans   &trans     &none
        //                                   ╰──────────────┴───────────────┴───────────────╯   ╰──────────┴──────────┴──────────╯
            >;
        };

        system_admin_layer {
            display-name = "SYSADM";
            bindings = <
        //╭────────┬──────────────┬──────────────┬──────────────┬──────────┬────────────╮   ╭────────────┬──────────┬──────────┬──────────┬──────────┬────────╮
        //│        │  BT disc 1   │  BT disc 2   │  BT disc 3   │          │  BOOTLOAD  │   │  BOOTLOAD  │          │          │          │          │        │
            &trans  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &trans    &bootloader      &bootloader  &trans     &trans     &trans     &trans     &trans
        //├────────┼──────────────┼──────────────┼──────────────┼──────────┼────────────┤   ├────────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│        │              │              │              │          │            │   │            │          │          │          │          │        │
            &trans   &trans         &trans         &trans         &trans     &trans           &trans       &trans     &trans     &trans     &trans     &trans
        //├────────┼──────────────┼──────────────┼──────────────┼──────────┼────────────┤   ├────────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│        │              │  BT clear    │  BT clr all  │          │            │   │            │          │          │          │          │        │
            &trans   &trans        &bt BT_CLR   &bt BT_CLR_ALL   &trans     &trans           &trans       &trans     &trans     &trans     &trans     &trans
        //╰────────┴──────────────┴──────────────┼──────────────┼──────────┼────────────┤   ├────────────┼──────────┼──────────┼──────────┴──────────┴────────╯
                                                   &none          &trans     &trans           &trans       &trans     &none
        //                                       ╰──────────────┴──────────┴────────────╯   ╰────────────┴──────────┴──────────╯
            >;
        };

        // ─── Gaming (left hand only) ───────────────────────────────────────────
        // Toggled on from SYS (hold the left inner thumb, tap the G key) and off
        // from GAME_EXT (hold the left outer thumb, tap the bottom pinky).
        //
        // QWERTY sits one column right of the Colemak alphas, which lands WASD on
        // the grip the column stagger was cut for: W and S share the column the
        // stagger pushes furthest forward (y=0 in toucan.dtsi — the middle
        // finger), A falls under the ring, D under the index.  TAB/LSHFT/LCTRL
        // then take the pinky column, the one pulled furthest back, exactly
        // where a staggered board wants them.  Every binding is a plain &kp — no
        // hold-taps, no home-row mods, nothing that can misfire when keys get
        // mashed.
        //
        // The thumb carries SPACE, LCTRL and the GAME_EXT hold.  SPACE takes the
        // middle key — that is where the thumb naturally falls, and jump is the
        // most-pressed key on the hand.  T and B are displaced by the mod column
        // and parked on GAME_EXT.
        //
        // The right half is deliberately dead: every position is &none, and the
        // trackpad is muted by the `gaming_mute` node in
        // boards/shields/toucan/toucan.dtsi, which keys off `layers = <6 7>` —
        // keep those literals in sync with GAME/GAME_EXT above.  The halves stay
        // BLE-paired (ZMK has no per-layer split shutdown), so the display and
        // battery reporting keep working; only input is silenced.  To bring the
        // right half back: replace its &none bindings here and in
        // gaming_extra_layer, and delete the gaming_mute node.
        //
        // Why crouch is on a thumb and grenade is on the corner key — both learned
        // the hard way after two days of play, so don't "fix" them back:
        //
        //   * LCTRL started on the bottom-left corner key and was unreachable in a
        //     fight.  Two reasons.  The pinky was already holding LSHFT one row up,
        //     so sprint and crouch were the same finger and sliding was physically
        //     impossible.  And on COLEMAK that corner key is `&ht LSHFT Z` — hold
        //     for shift, tap for Z — so after years of touch-typing the hand knows
        //     it only as a sustained hold, never as a quick stab.  Crouch belongs
        //     on a finger that drives neither WASD nor sprint, which leaves only
        //     the thumb.
        //
        //   * G started on the inner thumb next to SPACE — identical caps, no
        //     tactile landmark — and jump/grenade got swapped constantly.  Grenade
        //     is a deliberate, aimed action, so it can afford the corner key, and
        //     being nowhere near the thumb makes the mix-up impossible.
        //
        // Jump and crouch are the adjacent thumb pair now.  That is deliberate:
        // both are movement, so a mis-hit is self-correcting, unlike burning a
        // grenade on cooldown.
        // ────────────────────────────────────────────────────────────────────────
        gaming_layer {
            display-name = "GAME";
            bindings = <
        //╭────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬────────╮
        //│ (none) │  TAB     │  Q       │  W       │  E       │  R       │   │  (none)  │  (none)  │  (none)  │  (none)  │  (none)  │ (none) │
            &none    &kp TAB    &kp Q      &kp W      &kp E      &kp R          &none      &none      &none      &none      &none      &none
        //├────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│ (none) │  LSHFT   │  A       │  S       │  D       │  F       │   │  (none)  │  (none)  │  (none)  │  (none)  │  (none)  │ (none) │
            &none    &kp LSHFT  &kp A      &kp S      &kp D      &kp F          &none      &none      &none      &none      &none      &none
        //├────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│ (none) │  G       │  Z       │  X       │  C       │  V       │   │  (none)  │  (none)  │  (none)  │  (none)  │  (none)  │ (none) │
            &none    &kp G      &kp Z      &kp X      &kp C      &kp V          &none      &none      &none      &none      &none      &none
        //╰────────┴──────────┴──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┴──────────┴────────╯
        //                               │ GAME_EXT │  SPACE   │  LCTRL   │   │  (none)  │  (none)  │  (none)  │
                                          &mo GAME_EXT  &kp SPACE  &kp LCTRL    &none      &none      &none
        //                               ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
            >;
        };

        // Held with the left outer thumb.  1-4 sit directly above Q/W/E/R, just
        // like a real number row, and the pinky column keeps carrying the odd
        // keys out: ESC above TAB, LALT beside LSHFT, the exit toggle on the
        // corner key.  T and B — displaced from GAME by the mod column — are parked
        // on the bottom row.  The SPACE and LCTRL thumbs stay &trans so jump and
        // crouch still work while this layer is held.
        gaming_extra_layer {
            display-name = "GAMEFN";
            bindings = <
        //╭────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬────────╮
        //│ (none) │  ESC     │  1       │  2       │  3       │  4       │   │  (none)  │  (none)  │  (none)  │  (none)  │  (none)  │ (none) │
            &none    &kp ESC    &kp N1     &kp N2     &kp N3     &kp N4         &none      &none      &none      &none      &none      &none
        //├────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│ (none) │  LALT    │  5       │  6       │  7       │  8       │   │  (none)  │  (none)  │  (none)  │  (none)  │  (none)  │ (none) │
            &none    &kp LALT   &kp N5     &kp N6     &kp N7     &kp N8         &none      &none      &none      &none      &none      &none
        //├────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼────────┤
        //│ (none) │ GAME off │  9       │  0       │  T       │  B       │   │  (none)  │  (none)  │  (none)  │  (none)  │  (none)  │ (none) │
            &none    &tog GAME  &kp N9     &kp N0     &kp T      &kp B          &none      &none      &none      &none      &none      &none
        //╰────────┴──────────┴──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┴──────────┴────────╯
        //                               │  (hold)  │  SPACE   │  LCTRL   │   │  (none)  │  (none)  │  (none)  │
                                           &trans     &trans     &trans         &none      &none      &none
        //                               ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
            >;
        };

        extra_3 {
            status = "reserved";
        };
    };
};
